# Self-hosted baseline. Generate real values with:
#   python scripts/init_local_env.py
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
ALCHIMISTA_API_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
ADMIN_API_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY
PRIVACY_SERVICE_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
PRIVACY_VAULT_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY
PRIVACY_VAULT_KEY_VERSION=v1
AUDIT_REPORT_SIGNING_KEY=REPLACE_WITH_RANDOM_SIGNING_KEY
AUDIT_REPORT_SIGNING_KEY_ID=local-v1

LOCAL_AUTH_TENANTS=*
PRIVACY_POLICY=protect_egress
PRIVACY_MAPPING_ENABLED=true
PRIVACY_DETECTOR=rizzo_regex
