ALCHIMISTA_PROFILE=gcp
ALCHIMISTA_ENV=production
PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
REGION=europe-west4
DATABASE_URL=postgresql://REPLACE_ME

STORAGE_BACKEND=gcs
RAW_BUCKET=REPLACE_WITH_RAW_BUCKET
PROCESSED_BUCKET=REPLACE_WITH_PROCESSED_BUCKET
REPORTS_BUCKET=REPLACE_WITH_REPORTS_BUCKET
QUEUE_BACKEND=pubsub
INGEST_TOPIC=doc-ingest-topic
INGEST_DLQ_TOPIC=doc-ingest-topic-dlq
INGEST_DLQ_SUBSCRIPTION=doc-ingest-topic-dlq-sub

VECTOR_BACKEND=sql_embedding_scan
EMBEDDING_BACKEND=deterministic_hash
EMBEDDING_DIMENSIONS=128
VERTEX_INDEX_ID=
VERTEX_INDEX_ENDPOINT_ID=
VERTEX_DEPLOYED_INDEX_ID=
VERTEX_EMBEDDING_MODEL=text-embedding-004

AUTH_MODE=oidc
AUTH_ISSUER=https://REPLACE_WITH_ISSUER
AUTH_AUDIENCE=REPLACE_WITH_AUDIENCE
AUTH_JWKS_URL=
AUTH_ALGORITHMS=RS256
AUTH_TENANT_CLAIMS=tenant,tenants
AUTH_REQUIRE_TENANT_CLAIM=true

PRIVACY_POLICY=protect_egress
PRIVACY_SERVICE_URL=REPLACE_WITH_INTERNAL_PRIVACY_SERVICE_URL
PRIVACY_SERVICE_TOKEN=REPLACE_WITH_SECRET
PRIVACY_VAULT_ACTIVE_KEY_VERSION=v1
PRIVACY_VAULT_KEYS_JSON={"v1":"REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY"}
# Backward-compatible single-key variables; new deployments should use the keyring above.
PRIVACY_VAULT_KEY=REPLACE_WITH_SAME_V1_KEY
PRIVACY_VAULT_KEY_VERSION=v1
PRIVACY_MAPPING_ENABLED=true
PRIVACY_DETECTOR=rizzo_regex

ADMIN_API_KEY=REPLACE_WITH_SECRET
AUDIT_REPORT_SIGNING_KEY=REPLACE_WITH_SECRET
AUDIT_REPORT_SIGNING_KEY_ID=audit-key-v1
ENFORCE_STORAGE_HARDENING=true
